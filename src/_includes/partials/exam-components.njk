{#
  Mapped from Website Codebase/exam-components.jsx
  Each macro renders the same DOM the React component produced,
  so exam-styles.css is pixel-for-pixel reusable without edits.

  Interactivity changes vs. React:
    - TOC scroll-spy → JS via IntersectionObserver in exam.js
    - SampleQuestion reveal → JS in exam.js (reuses built-in reveal state)
    - ExamFAQ accordion → reuses existing data-faq hook from app.js
    - TipsWidget carousel → flattened to a static list (all tips indexed for SEO)
#}

{# ========== Breadcrumb ========== #}
{% macro breadcrumb(trail) %}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {% for c in trail %}
      <li>
        {% if not loop.last %}
          <a href="{{ c.href }}">{{ c.label }}</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
        {% else %}
          <span aria-current="page">{{ c.label }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</nav>
{% endmacro %}

{# ========== Exam Hero ========== #}
{% macro examHero(exam, catLabel, catId) %}
<section class="exam-hero">
  <div class="container">
    {{ breadcrumb([
      { label: "Home", href: "/" },
      { label: "Certifications", href: "/#certifications" },
      { label: catLabel, href: "/#group-" ~ catId },
      { label: exam.code ~ " Certification" }
    ]) }}

    <div class="exam-hero-grid">
      <div>
        <div class="exam-hero-meta">
          <span class="exam-hero-body">Issued by {{ exam.body }}</span>
          <span class="exam-hero-sep" aria-hidden="true">·</span>
          <span>Updated {{ exam.updatedLabel or "April 2026" }}</span>
        </div>
        <h1 class="exam-hero-title">
          <span class="exam-hero-code">{{ exam.code }}</span>
          <span class="exam-hero-name">{{ exam.name }}</span>
        </h1>
        <p class="exam-hero-sub">{{ exam.lede | safe }}</p>

        <div class="exam-hero-pills">
          {% for p in exam.heroPills %}
            <div class="exam-pill">
              <span class="exam-pill-k">{{ p.k }}</span>
              <span class="exam-pill-v">{{ p.v }}</span>
            </div>
          {% endfor %}
        </div>

        <div class="exam-hero-cta">
          <a class="btn btn-primary btn-lg" href="{{ exam.practiceTestUrl or '#' }}">Start {{ exam.code }} practice</a>
          <a class="btn btn-ghost btn-lg" href="#cost">How to apply</a>
        </div>
      </div>

      <aside class="exam-hero-card" aria-label="Exam at a glance">
        <div class="exam-hero-card-head">
          <span class="exam-hero-card-badge">{{ exam.code }}</span>
          <span class="exam-hero-card-tag">At a glance</span>
        </div>
        <dl class="exam-hero-card-list">
          {% for row in exam.ataGlance %}
            <div class="exam-hero-card-row">
              <dt>{{ row.k }}</dt>
              <dd>{{ row.v | safe }}</dd>
            </div>
          {% endfor %}
        </dl>
        {% if exam.heroCardFoot %}
        <div class="exam-hero-card-foot">
          <span class="exam-hero-card-foot-dot"></span>
          <span>{{ exam.heroCardFoot }}</span>
        </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>
{% endmacro %}

{# ========== TOC ========== #}
{% macro toc(sections) %}
<nav class="toc" data-exam-toc aria-label="On this page">
  <div class="toc-head">On this page</div>
  <ul>
    {% for s in sections %}
      <li data-toc-target="{{ s.id }}"{% if loop.first %} class="toc-on"{% endif %}>
        <a href="#{{ s.id }}">{{ s.label }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
{% endmacro %}

{# ========== Fact box ========== #}
{% macro factBox(box) %}
<aside class="factbox factbox-{{ box.tone or 'info' }}" role="note">
  <span class="factbox-icon" aria-hidden="true">
    {% if box.tone == 'warn' %}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.7 3.86a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg>
    {% elif box.tone == 'success' %}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
    {% else %}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    {% endif %}
  </span>
  <div class="factbox-body">
    <div class="factbox-title">{{ box.title }}</div>
    <div class="factbox-content">{{ box.html | safe }}</div>
  </div>
</aside>
{% endmacro %}

{# ========== Stat Grid ========== #}
{% macro statGrid(stats) %}
<div class="statgrid">
  {% for s in stats %}
    <div class="statcard">
      <span class="statcard-n">{{ s.n }}</span>
      <span class="statcard-l">{{ s.l }}</span>
      {% if s.sub %}<span class="statcard-sub">{{ s.sub }}</span>{% endif %}
    </div>
  {% endfor %}
</div>
{% endmacro %}

{# ========== Blueprint chart (SVG donut) ========== #}
{% macro blueprintChart(domains) %}
{% set segments = domains | arcSegments %}
<div class="blueprint">
  <div class="blueprint-chart" role="img" aria-label="Exam content blueprint">
    <svg viewBox="0 0 220 220" width="220" height="220">
      <circle cx="110" cy="110" r="92" fill="none" stroke="var(--border-subtle)" stroke-width="36"></circle>
      {% for s in segments %}
        <circle
          cx="110"
          cy="110"
          r="92"
          fill="none"
          stroke="{{ s.color }}"
          stroke-width="36"
          stroke-dasharray="{{ s.dashLen }} {{ s.gap }}"
          stroke-dashoffset="{{ s.offset }}"
          transform="rotate(-90 110 110)"
        ></circle>
      {% endfor %}
    </svg>
    <div class="blueprint-center">
      <span class="blueprint-center-n">{{ domains.length }}</span>
      <span class="blueprint-center-l">domains</span>
    </div>
  </div>
  <ul class="blueprint-legend">
    {% for s in segments %}
      <li>
        <span class="blueprint-swatch" style="background: {{ s.color }}"></span>
        <span class="blueprint-label">{{ s.label }}</span>
        <span class="blueprint-weight">{{ s.weight }}%</span>
      </li>
    {% endfor %}
  </ul>
</div>
{% endmacro %}

{# ========== Pass-rate bar chart ========== #}
{% macro passChart(rows, target, footnote) %}
<div class="passchart">
  <div class="passchart-head">
    <div>
      <div class="passchart-title">First-time pass rates</div>
      <div class="passchart-sub">Reporting · target {{ target }}%</div>
    </div>
    <div class="passchart-legend">
      <span><span class="passchart-swatch passchart-sw-pass"></span>Pass</span>
      <span><span class="passchart-swatch passchart-sw-target"></span>Target</span>
    </div>
  </div>
  <div class="passchart-body">
    {% for row in rows %}
      <div class="passchart-row">
        <span class="passchart-year">{{ row.year }}</span>
        <div class="passchart-track">
          <div class="passchart-bar" style="width: {{ row.pct }}%">
            <span class="passchart-val">{{ row.pct }}%</span>
          </div>
          <div class="passchart-target" style="left: {{ target }}%" aria-hidden="true"></div>
        </div>
      </div>
    {% endfor %}
  </div>
  {% if footnote %}<div class="passchart-foot">{{ footnote }}</div>{% endif %}
</div>
{% endmacro %}

{# ========== Study plan ========== #}
{% macro studyPlan(weeks, subtitle) %}
{% set maxQs = weeks | maxQs %}
<div class="plan">
  <div class="plan-head">
    <div>
      <div class="plan-title">{{ weeks.length }}-week study plan</div>
      {% if subtitle %}<div class="plan-sub">{{ subtitle }}</div>{% endif %}
    </div>
  </div>
  <ol class="plan-list">
    {% for w in weeks %}
      {% set pct = (w.qs / maxQs) * 100 %}
      <li class="plan-week">
        <div class="plan-week-n">
          <span class="plan-week-num">{{ w.n }}</span>
          <span class="plan-week-label">Week</span>
        </div>
        <div class="plan-week-body">
          <div class="plan-week-focus">{{ w.focus }}</div>
          <div class="plan-week-bar">
            <div class="plan-week-fill" style="width: {{ pct }}%"></div>
            <span class="plan-week-qs">{{ w.qs }} Qs</span>
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
{% endmacro %}

{# ========== Tips — rendered as a static list (SEO-friendly) ========== #}
{# Every tip is indexable; the original React carousel hid 4/5 at load time. #}
{% macro tipsList(tips) %}
<aside class="tips" aria-label="Study tips">
  <div class="tips-head">
    <span class="tips-label">
      <span class="tips-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
      </span>
      Study tips
    </span>
    <span class="tips-count">{{ tips.length }} tips</span>
  </div>
  <div class="tips-body tips-body-list">
    {% for t in tips %}
      <div class="tips-entry">
        <div class="tips-kicker">{{ t.kicker }}</div>
        <p class="tips-text">{{ t.text }}</p>
      </div>
    {% endfor %}
  </div>
</aside>
{% endmacro %}

{# ========== Cost table ========== #}
{% macro costTable(rows) %}
<div class="cost-table-wrap">
  <table class="cost-table">
    <thead>
      <tr><th>Fee item</th><th>Cost (USD)</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
        <tr{% if r.highlight %} class="cost-row-hi"{% endif %}>
          <td>{{ r.k }}</td>
          <td><strong>{{ r.v }}</strong></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# ========== Sample question ========== #}
{% macro sampleQuestion(q, code) %}
<div class="sampleq" data-sampleq data-correct="{{ q.correct }}">
  <div class="sampleq-label">Sample {{ code }} exam item</div>
  <div class="sampleq-scenario">{{ q.scenario | safe }}</div>
  <div class="sampleq-stem">{{ q.stem | safe }}</div>
  <div class="sampleq-opts">
    {% for o in q.options %}
      <button type="button" class="sampleq-opt" data-idx="{{ loop.index0 }}">
        <span class="sampleq-opt-letter">{{ ["A","B","C","D","E","F"][loop.index0] }}</span>
        <span class="sampleq-opt-text">{{ o }}</span>
      </button>
    {% endfor %}
  </div>
  <div class="sampleq-rationale" hidden>
    <div class="sampleq-rationale-label">Rationale</div>
    <p>{{ q.rationale | safe }}</p>
    <button type="button" class="sampleq-reset">Try again</button>
  </div>
</div>
{% endmacro %}

{# ========== Key-terms table ========== #}
{% macro keytermTable(rows) %}
<div class="keyterm-table-wrap">
  <table class="keyterm-table">
    <thead><tr><th>Term</th><th>Definition</th><th>Domain</th></tr></thead>
    <tbody>
      {% for k in rows %}
        <tr><td>{{ k.term }}</td><td>{{ k.defn }}</td><td>{{ k.domain }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# ========== Comparison table ========== #}
{% macro compareTable(rows) %}
<div class="comparison-table-wrap">
  <table class="comparison-table">
    <thead>
      <tr><th>Credential</th><th>Body</th><th>Scope</th><th>Best fit</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
        <tr{% if r.highlight %} class="row-hi"{% endif %}>
          <td>{{ r.row }}</td><td>{{ r.body }}</td><td>{{ r.scope }}</td><td>{{ r.who }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# ========== Exam FAQ — reuses existing data-faq accordion from app.js ========== #}
{% macro examFaq(items) %}
<div class="exam-faq">
  {% for it in items %}
    <div class="faq-item{% if loop.first %} faq-open{% endif %}" data-faq>
      <button type="button" class="faq-q" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">
        <span>{{ it.q }}</span>
        <span class="faq-plus" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="faq-a" role="region">
        <p>{{ it.a }}</p>
      </div>
    </div>
  {% endfor %}
</div>
{% endmacro %}

{# ========== Related articles ========== #}
{% macro relatedArticles(items) %}
<div class="related-grid">
  {% for r in items %}
    <a class="related-card" href="{{ r.href }}">
      <div class="related-thumb" style="background: {{ r.bg }}">
        <span class="related-thumb-tag">{{ r.tag }}</span>
        <svg class="related-thumb-art" viewBox="0 0 200 120" aria-hidden="true">
          <defs>
            <linearGradient id="rel-g-{{ loop.index0 }}" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="rgba(255,255,255,0.6)"/>
              <stop offset="100%" stop-color="rgba(255,255,255,0.15)"/>
            </linearGradient>
          </defs>
          <circle cx="160" cy="30" r="50" fill="url(#rel-g-{{ loop.index0 }})"></circle>
          <circle cx="30" cy="100" r="30" fill="url(#rel-g-{{ loop.index0 }})"></circle>
          <path d="M0,80 Q50,60 100,80 T200,80" stroke="rgba(255,255,255,0.35)" stroke-width="2" fill="none"></path>
        </svg>
      </div>
      <div class="related-body">
        <div class="related-kicker">{{ r.kicker }}</div>
        <h4>{{ r.title }}</h4>
        <p>{{ r.blurb }}</p>
        <span class="related-read">
          Read article
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </div>
    </a>
  {% endfor %}
</div>
{% endmacro %}

{# ========== Cover image (cert-card hero) ========== #}
{# Renders the data-driven cert hero card PNG built by /cert-hero-images/generate-hero.js.
   Third `accent` arg kept for backward compatibility with callers; unused now. #}
{% macro coverImage(label, code, accent) %}
<figure class="cover-image" aria-label="{{ label }}">
  <img
    src="/assets/images/certs/{{ code | lower }}-card.png"
    alt="{{ code }} — {{ label }}"
    width="1200"
    height="630"
    loading="lazy"
    decoding="async">
  <figcaption class="cover-caption">{{ label }}</figcaption>
</figure>
{% endmacro %}
