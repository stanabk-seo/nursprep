---
# Cloudflare Pages serves /404.html with HTTP 404 for any URL that doesn't
# exist. Without it, Pages falls back to the homepage with a 200 status
# ("soft 404"), letting search engines index made-up URLs as duplicates.
layout: layouts/base.njk
permalink: /404.html
eleventyExcludeFromCollections: true
title: Page not found | NursPrep
description: The page you were looking for doesn't exist. Browse all nursing certifications on NursPrep.
---

{% include "partials/nav.njk" %}

<main>
  <section class="certifications">
    <div class="container">
      <div class="empty">
        <span class="empty-icon" aria-hidden="true">⌕</span>
        <h1>Page not found</h1>
        <p>The page you were looking for doesn't exist or has moved.</p>
        <p style="margin-top: 24px;">
          <a href="/#certifications" class="btn btn-primary btn-lg">Browse all {{ certs.length }} certifications</a>
          <a href="/" class="btn btn-ghost btn-lg">Go to homepage</a>
        </p>
        {% if site.featuredChips.length %}
        <div class="hero-chips" style="justify-content: center; margin-top: 24px;">
          <span class="hero-chips-label">Popular:</span>
          {% for chip in site.featuredChips %}
            <a class="chip chip-featured" href="/certifications/{{ chip | lower }}/">{{ chip }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </section>
</main>

{% include "partials/footer.njk" %}
